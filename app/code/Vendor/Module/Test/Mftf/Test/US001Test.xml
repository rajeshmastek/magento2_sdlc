<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    
    <actionGroup name="AdminSelectCatalogInputTypeForProductAttributeActionGroup">
        <annotations>
            <description>Select catalog input type for product attribute</description>
        </annotations>
        <arguments>
            <argument name="inputType" type="string"/>
        </arguments>
        <selectOption selector="{{AttributePropertiesSection.InputType}}" userInput="{{inputType}}" stepKey="selectInputType"/>
    </actionGroup>

    <actionGroup name="AdminSetProductAttributeScopeActionGroup">
        <annotations>
            <description>Set product attribute scope</description>
        </annotations>
        <arguments>
            <argument name="scope" type="string"/>
        </arguments>
        <selectOption selector="{{AttributePropertiesSection.Scope}}" userInput="{{scope}}" stepKey="selectScope"/>
    </actionGroup>

    <actionGroup name="AdminSetProductAttributeLayeredNavigationActionGroup">
        <annotations>
            <description>Set product attribute layered navigation option</description>
        </annotations>
        <arguments>
            <argument name="layeredNavigation" type="string"/>
        </arguments>
        <click selector="{{StorefrontPropertiesSection.StoreFrontPropertiesTab}}" stepKey="goToStorefrontProperties"/>
        <waitForElementVisible selector="{{StorefrontPropertiesSection.UseInLayeredNavigation}}" stepKey="waitForLayeredNavField"/>
        <selectOption selector="{{StorefrontPropertiesSection.UseInLayeredNavigation}}" userInput="Filterable (with results)" stepKey="selectLayeredNavigation"/>
    </actionGroup>

    <actionGroup name="AdminSetProductAttributeVisibleOnStorefrontActionGroup">
        <annotations>
            <description>Set product attribute visible on storefront</description>
        </annotations>
        <arguments>
            <argument name="visible" type="string"/>
        </arguments>
        <click selector="{{StorefrontPropertiesSection.StoreFrontPropertiesTab}}" stepKey="goToStorefrontPropertiesTab"/>
        <waitForElementVisible selector="{{StorefrontPropertiesSection.VisibleOnCatalogPagesOnStorefront}}" stepKey="waitForVisibilityField"/>
        <selectOption selector="{{StorefrontPropertiesSection.VisibleOnCatalogPagesOnStorefront}}" userInput="Yes" stepKey="setVisibleOnStorefront"/>
    </actionGroup>

    <actionGroup name="AdminProductAttributeAssignToAttributeSetActionGroup">
        <annotations>
            <description>Assign product attribute to attribute set</description>
        </annotations>
        <arguments>
            <argument name="attributeSet" type="string"/>
        </arguments>
        <click selector="{{AttributePropertiesSection.AdvancedProperties}}" stepKey="expandAdvancedProperties"/>
        <waitForElementVisible selector="{{AttributePropertiesSection.AttributeSet}}" stepKey="waitForAttributeSetField"/>
        <selectOption selector="{{AttributePropertiesSection.AttributeSet}}" userInput="{{attributeSet}}" stepKey="selectAttributeSet"/>
    </actionGroup>

    <actionGroup name="AssertAdminProductAttributeSaveMessageActionGroup">
        <annotations>
            <description>Verify product attribute save success message</description>
        </annotations>
        <waitForElementVisible selector="{{AdminMessagesSection.success}}" stepKey="waitForSuccessMessage"/>
        <see selector="{{AdminMessagesSection.success}}" userInput="You saved the product attribute." stepKey="seeSuccessMessage"/>
    </actionGroup>

    <actionGroup name="AdminVerifyProductAttributeInGridActionGroup">
        <annotations>
            <description>Verify product attribute exists in grid</description>
        </annotations>
        <arguments>
            <argument name="attributeCode" type="string"/>
        </arguments>
        <actionGroup ref="AdminOpenProductAttributePageActionGroup" stepKey="navigateToAttributeGrid"/>
        <fillField selector="{{AdminProductAttributeGridSection.FilterByAttributeCode}}" userInput="{{attributeCode}}" stepKey="fillAttributeCodeFilter"/>
        <click selector="{{AdminProductAttributeGridSection.Search}}" stepKey="clickSearch"/>
        <waitForPageLoad stepKey="waitForGridLoad"/>
        <see selector="{{AdminProductAttributeGridSection.FirstRow}}" userInput="{{attributeCode}}" stepKey="seeAttributeInGrid"/>
    </actionGroup>

    <actionGroup name="AdminOpenAttributeSetByNameActionGroup">
        <annotations>
            <description>Open attribute set by name</description>
        </annotations>
        <arguments>
            <argument name="attributeSetName" type="string"/>
        </arguments>
        <amOnPage url="{{AdminProductAttributeSetGridPage.url}}" stepKey="goToAttributeSetPage"/>
        <waitForPageLoad stepKey="waitForAttributeSetPage"/>
        <fillField selector="{{AdminProductAttributeSetGridSection.filter}}" userInput="{{attributeSetName}}" stepKey="filterByName"/>
        <click selector="{{AdminProductAttributeSetGridSection.searchBtn}}" stepKey="clickSearch"/>
        <waitForPageLoad stepKey="waitForSearchResults"/>
        <click selector="{{AdminProductAttributeSetGridSection.firstRow}}" stepKey="clickFirstRow"/>
        <waitForPageLoad stepKey="waitForAttributeSetEdit"/>
    </actionGroup>

    <actionGroup name="AdminVerifyAttributeInAttributeSetActionGroup">
        <annotations>
            <description>Verify attribute exists in attribute set</description>
        </annotations>
        <arguments>
            <argument name="attributeCode" type="string"/>
        </arguments>
        <waitForElementVisible selector="{{AdminProductAttributeSetEditSection.unassignedAttributes}}" stepKey="waitForUnassignedAttributes"/>
        <see selector="{{AdminProductAttributeSetEditSection.assignedAttributes}}" userInput="{{attributeCode}}" stepKey="seeAttributeInSet"/>
    </actionGroup>

    <actionGroup name="AdminOpenNewProductFormActionGroup">
        <annotations>
            <description>Open new product form</description>
        </annotations>
        <amOnPage url="{{AdminProductCreatePage.url(AddProductType.simple, AddProductSet.default)}}" stepKey="navigateToNewProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
    </actionGroup>

    <actionGroup name="AdminVerifyProductAttributeAvailableInFormActionGroup">
        <annotations>
            <description>Verify product attribute is available in product form</description>
        </annotations>
        <arguments>
            <argument name="attributeCode" type="string"/>
        </arguments>
        <scrollTo selector="{{AdminProductFormSection.contentTab}}" stepKey="scrollToContentTab"/>
        <conditionalClick selector="{{AdminProductFormSection.contentTab}}" dependentSelector="{{AdminProductFormSection.contentTabOpen}}" visible="false" stepKey="openContentTab"/>
        <waitForElementVisible selector="//input[@name='product[{{attributeCode}}]'] | //textarea[@name='product[{{attributeCode}}]'] | //select[@name='product[{{attributeCode}}]']" stepKey="waitForAttributeField"/>
        <seeElement selector="//input[@name='product[{{attributeCode}}]'] | //textarea[@name='product[{{attributeCode}}]'] | //select[@name='product[{{attributeCode}}]']" stepKey="seeAttributeField"/>
    </actionGroup>
</actionGroups>