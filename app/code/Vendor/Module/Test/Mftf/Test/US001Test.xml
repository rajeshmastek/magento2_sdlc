<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminCreateWarrantyPeriodProductAttributeTest">
        <annotations>
            <features value="Catalog"/>
            <stories value="As a catalog admin, I want to create a 'warranty_period' product attribute so that I can configure warranty information for each product in the catalog"/>
            <title value="Create warranty_period product attribute with layered navigation and storefront visibility"/>
            <description value="Verify that catalog admin can create warranty_period attribute with text field input type, store view scope, layered navigation enabled, and storefront visibility"/>
            <severity value="CRITICAL"/>
            <testCaseId value="AC-CATALOG-001"/>
            <group value="catalog"/>
            <group value="product_attribute"/>
            <group value="eav"/>
            <group value="layered_navigation"/>
        </annotations>

        <before>
            <!-- Login as admin -->
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>

        <after>
            <!-- Delete created attribute -->
            <actionGroup ref="DeleteProductAttributeActionGroup" stepKey="deleteWarrantyAttribute">
                <argument name="ProductAttribute" value="warrantyPeriodAttribute"/>
            </actionGroup>
            <actionGroup ref="CliIndexerReindexActionGroup" stepKey="reindexAfterDelete">
                <argument name="indices" value=""/>
            </actionGroup>
            <actionGroup ref="CliCacheFlushActionGroup" stepKey="flushCacheAfterDelete">
                <argument name="tags" value=""/>
            </actionGroup>
            <!-- Logout -->
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logout"/>
        </after>

        <!-- Navigate to Stores > Attributes > Product -->
        <actionGroup ref="AdminOpenProductAttributePageActionGroup" stepKey="goToProductAttributePage"/>

        <!-- Click 'Add New Attribute' -->
        <actionGroup ref="AdminNavigateToNewProductAttributePageActionGroup" stepKey="clickAddNewAttribute"/>

        <!-- Set Attribute Code to 'warranty_period' -->
        <actionGroup ref="AdminFillProductAttributePropertiesActionGroup" stepKey="fillAttributeProperties">
            <argument name="attributeCode" value="{{warrantyPeriodAttribute.attribute_code}}"/>
            <argument name="defaultLabel" value="{{warrantyPeriodAttribute.default_frontend_label}}"/>
        </actionGroup>

        <!-- Set Catalog Input Type to 'Text Field' -->
        <actionGroup ref="AdminSelectCatalogInputTypeForProductAttributeActionGroup" stepKey="selectTextFieldInputType">
            <argument name="inputType" value="{{warrantyPeriodAttribute.frontend_input}}"/>
        </actionGroup>

        <!-- Set Scope to 'Store View' -->
        <actionGroup ref="AdminSetProductAttributeScopeActionGroup" stepKey="setAttributeScope">
            <argument name="scope" value="{{warrantyPeriodAttribute.scope}}"/>
        </actionGroup>

        <!-- Set 'Use in Layered Navigation' to 'Filterable (with results)' -->
        <actionGroup ref="AdminSetProductAttributeLayeredNavigationActionGroup" stepKey="setLayeredNavigation">
            <argument name="layeredNavigation" value="{{warrantyPeriodAttribute.is_filterable}}"/>
        </actionGroup>

        <!-- Set 'Visible on Catalog Pages on Storefront' to 'Yes' -->
        <actionGroup ref="AdminSetProductAttributeVisibleOnStorefrontActionGroup" stepKey="setStorefrontVisibility">
            <argument name="visible" value="{{warrantyPeriodAttribute.is_visible_on_front}}"/>
        </actionGroup>

        <!-- Add the attribute to 'Default' attribute set -->
        <actionGroup ref="AdminProductAttributeAssignToAttributeSetActionGroup" stepKey="assignToDefaultAttributeSet">
            <argument name="attributeSet" value="Default"/>
        </actionGroup>

        <!-- Save the attribute -->
        <actionGroup ref="SaveProductAttributeActionGroup" stepKey="saveProductAttribute"/>

        <!-- Verify success message -->
        <actionGroup ref="AssertAdminProductAttributeSaveMessageActionGroup" stepKey="verifySuccessMessage"/>

        <!-- Verify the warranty_period attribute should be created successfully -->
        <actionGroup ref="AdminVerifyProductAttributeInGridActionGroup" stepKey="verifyAttributeInGrid">
            <argument name="attributeCode" value="{{warrantyPeriodAttribute.attribute_code}}"/>
        </actionGroup>

        <!-- Verify the attribute should appear in the Default attribute set -->
        <actionGroup ref="AdminOpenAttributeSetByNameActionGroup" stepKey="openDefaultAttributeSet">
            <argument name="attributeSetName" value="Default"/>
        </actionGroup>
        <actionGroup ref="AdminVerifyAttributeInAttributeSetActionGroup" stepKey="verifyAttributeInSet">
            <argument name="attributeCode" value="{{warrantyPeriodAttribute.attribute_code}}"/>
        </actionGroup>

        <!-- Run indexer reindex -->
        <actionGroup ref="CliIndexerReindexActionGroup" stepKey="reindexCatalogProductAttribute">
            <argument name="indices" value="catalog_product_attribute"/>
        </actionGroup>

        <!-- Run cache flush -->
        <actionGroup ref="CliCacheFlushActionGroup" stepKey="flushCache">
            <argument name="tags" value=""/>
        </actionGroup>

        <!-- Verify attribute is available for product assignment -->
        <actionGroup ref="AdminOpenNewProductFormActionGroup" stepKey="openNewProductForm"/>
        <actionGroup ref="AdminVerifyProductAttributeAvailableInFormActionGroup" stepKey="verifyAttributeAvailable">
            <argument name="attributeCode" value="{{warrantyPeriodAttribute.attribute_code}}"/>
        </actionGroup>
    </test>
</tests>
