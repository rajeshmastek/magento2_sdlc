{
  "files": {
    "registration.php": "<?php\ndeclare(strict_types=1);\n\nuse Magento\\Framework\\Component\\ComponentRegistrar;\n\nComponentRegistrar::register(\n    ComponentRegistrar::MODULE,\n    'Vendor_ImageTagging',\n    __DIR__\n);",
    "etc/module.xml": "<?xml version=\"1.0\"?>\n<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:framework:Module/etc/module.xsd\">\n    <module name=\"Vendor_ImageTagging\">\n        <sequence>\n            <module name=\"Magento_Catalog\"/>\n            <module name=\"Magento_Eav\"/>\n            <module name=\"Magento_Backend\"/>\n            <module name=\"Magento_AsynchronousOperations\"/>\n        </sequence>\n    </module>\n</config>",
    "etc/adminhtml/system.xml": "<?xml version=\"1.0\"?>\n<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:module:Magento_Config:etc/system_file.xsd\">\n    <system>\n        <tab id=\"catalog\" translate=\"label\" sortOrder=\"200\">\n            <label>Catalog</label>\n        </tab>\n        <section id=\"image_tagging\" translate=\"label\" sortOrder=\"400\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n            <label>Product Image Tagging</label>\n            <tab>catalog</tab>\n            <resource>Vendor_ImageTagging::config</resource>\n            <group id=\"general\" translate=\"label\" sortOrder=\"10\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                <label>General Settings</label>\n                <field id=\"enabled\" translate=\"label\" type=\"select\" sortOrder=\"10\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                    <label>Enable Image Tagging</label>\n                    <source_model>Magento\\Config\\Model\\Config\\Source\\Yesno</source_model>\n                </field>\n                <field id=\"ai_service_url\" translate=\"label\" type=\"text\" sortOrder=\"20\" showInDefault=\"1\" showInWebsite=\"0\" showInStore=\"0\">\n                    <label>AI Service URL</label>\n                    <depends>\n                        <field id=\"enabled\">1</field>\n                    </depends>\n                </field>\n                <field id=\"ai_service_key\" translate=\"label\" type=\"obscure\" sortOrder=\"30\" showInDefault=\"1\" showInWebsite=\"0\" showInStore=\"0\">\n                    <label>AI Service API Key</label>\n                    <backend_model>Magento\\Config\\Model\\Config\\Backend\\Encrypted</backend_model>\n                    <depends>\n                        <field id=\"enabled\">1</field>\n                    </depends>\n                </field>\n                <field id=\"confidence_threshold\" translate=\"label comment\" type=\"text\" sortOrder=\"40\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                    <label>Confidence Threshold (%)</label>\n                    <comment>Minimum confidence score (0-100) to auto-apply tags</comment>\n                    <validate>validate-number validate-number-range number-range-0-100</validate>\n                    <depends>\n                        <field id=\"enabled\">1</field>\n                    </depends>\n                </field>\n                <field id=\"auto_apply\" translate=\"label\" type=\"select\" sortOrder=\"50\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                    <label>Auto-Apply High Confidence Tags</label>\n                    <source_model>Magento\\Config\\Model\\Config\\Source\\Yesno</source_model>\n                    <depends>\n                        <field id=\"enabled\">1</field>\n                    </depends>\n                </field>\n            </group>\n            <group id=\"attribute_mapping\" translate=\"label\" sortOrder=\"20\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                <label>Attribute Mapping Rules</label>\n                <field id=\"color_attribute\" translate=\"label\" type=\"select\" sortOrder=\"10\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                    <label>Color Attribute Code</label>\n                    <source_model>Vendor\\ImageTagging\\Model\\Config\\Source\\ProductAttributes</source_model>\n                </field>\n                <field id=\"material_attribute\" translate=\"label\" type=\"select\" sortOrder=\"20\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                    <label>Material Attribute Code</label>\n                    <source_model>Vendor\\ImageTagging\\Model\\Config\\Source\\ProductAttributes</source_model>\n                </field>\n                <field id=\"style_attribute\" translate=\"label\" type=\"select\" sortOrder=\"30\" showInDefault=\"1\" showInWebsite=\"1\" showInStore=\"1\">\n                    <label>Style Attribute Code</label>\n                    <source_model>Vendor\\ImageTagging\\Model\\Config\\Source\\ProductAttributes</source_model>\n                </field>\n            </group>\n        </section>\n    </system>\n</config>",
    "etc/acl.xml": "<?xml version=\"1.0\"?>\n<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:framework:Acl/etc/acl.xsd\">\n    <acl>\n        <resources>\n            <resource id=\"Magento_Backend::admin\">\n                <resource id=\"Magento_Backend::stores\">\n                    <resource id=\"Magento_Backend::stores_settings\">\n                        <resource id=\"Magento_Config::config\">\n                            <resource id=\"Vendor_ImageTagging::config\" title=\"Product Image Tagging Configuration\"/>\n                        </resource>\n                    </resource>\n                </resource>\n                <resource id=\"Magento_Catalog::catalog\">\n                    <resource id=\"Magento_Catalog::products\">\n                        <resource id=\"Vendor_ImageTagging::analyze_images\" title=\"Analyze Product Images\"/>\n                    </resource>\n                </resource>\n            </resource>\n        </resources>\n    </acl>\n</config>",
    "etc/di.xml": "<?xml version=\"1.0\"?>\n<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:framework:ObjectManager/etc/config.xsd\">\n    \n    <!-- Service Contracts -->\n    <preference for=\"Vendor\\ImageTagging\\Api\\ImageAnalysisServiceInterface\"\n                type=\"Vendor\\ImageTagging\\Model\\Service\\ImageAnalysisService\"/>\n    <preference for=\"Vendor\\ImageTagging\\Api\\AttributeTaggingServiceInterface\"\n                type=\"Vendor\\ImageTagging\\Model\\Service\\AttributeTaggingService\"/>\n    <preference for=\"Vendor\\ImageTagging\\Api\\Data\\TagSuggestionInterface\"\n                type=\"Vendor\\ImageTagging\\Model\\Data\\TagSuggestion\"/>\n    <preference for=\"Vendor\\ImageTagging\\Api\\Data\\AnalysisResultInterface\"\n                type=\"Vendor\\ImageTagging\\Model\\Data\\AnalysisResult\"/>\n    <preference for=\"Vendor\\ImageTagging\\Api\\TagSuggestionRepositoryInterface\"\n                type=\"Vendor\\ImageTagging\\Model\\TagSuggestionRepository\"/>\n    \n    <!-- Plugin to intercept product image save -->\n    <type name=\"Magento\\Catalog\\Model\\Product\\Gallery\\Processor\">\n        <plugin name=\"vendor_image_tagging_gallery_processor\"\n                type=\"Vendor\\ImageTagging\\Plugin\\Catalog\\Model\\Product\\Gallery\\ProcessorPlugin\"\n                sortOrder=\"10\"/>\n    </type>\n    \n    <!-- Virtual Types for Async Operations -->\n    <virtualType name=\"Vendor\\ImageTagging\\Model\\BulkAnalysis\\Publisher\" type=\"Magento\\Framework\\MessageQueue\\Publisher\">\n        <arguments>\n            <argument name=\"connection\" xsi:type=\"string\">amqp</argument>\n        </arguments>\n    </virtualType>\n    \n    <type name=\"Vendor\\ImageTagging\\Model\\BulkAnalysis\\ScheduleBulk\">\n        <arguments>\n            <argument name=\"publisher\" xsi:type=\"object\">Vendor\\ImageTagging\\Model\\BulkAnalysis\\Publisher</argument>\n        </arguments>\n    </type>\n    \n</config>",
    "etc/events.xml": "<?xml version=\"1.0\"?>\n<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:framework:Event/etc/events.xsd\">\n    \n    <!-- Observer for product save to trigger analysis if configured -->\n    <event name=\"catalog_product_save_after\">\n        <observer name=\"vendor_image_tagging_product_save\"\n                  instance=\"Vendor\\ImageTagging\\Observer\\ProductSaveAfterObserver\"/>\n    </event>\n    \n    <!-- Observer for attribute application to trigger reindex -->\n    <event name=\"vendor_image_tagging_attributes_applied\">\n        <observer name=\"vendor_image_tagging_reindex\"\n                  instance=\"Vendor\\ImageTagging\\Observer\\TriggerPartialReindexObserver\"/>\n    </event>\n    \n</config>",
    "etc/db_schema.xml": "<?xml version=\"1.0\"?>\n<schema xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd\">\n    \n    <table name=\"vendor_image_tag_suggestion\" resource=\"default\" engine=\"innodb\" comment=\"Image Tag Suggestions\">\n        <column xsi:type=\"int\" name=\"suggestion_id\" unsigned=\"true\" nullable=\"false\" identity=\"true\" comment=\"Suggestion ID\"/>\n        <column xsi:type=\"int\" name=\"product_id\" unsigned=\"true\" nullable=\"false\" comment=\"Product ID\"/>\n        <column xsi:type=\"varchar\" name=\"image_path\" nullable=\"false\" length=\"255\" comment=\"Image Path\"/>\n        <column xsi:type=\"varchar\" name=\"attribute_code\" nullable=\"false\" length=\"255\" comment=\"Attribute Code\"/>\n        <column xsi:type=\"text\" name=\"suggested_value\" nullable=\"false\" comment=\"Suggested Value\"/>\n        <column xsi:type=\"decimal\" name=\"confidence_score\" scale=\"4\" precision=\"10\" unsigned=\"false\" nullable=\"false\" default=\"0\" comment=\"Confidence Score\"/>\n        <column xsi:type=\"varchar\" name=\"status\" nullable=\"false\" length=\"50\" default=\"pending\" comment=\"Status: pending, applied, rejected, low_confidence\"/>\n        <column xsi:type=\"int\" name=\"admin_user_id\" unsigned=\"true\" nullable=\"true\" comment=\"Admin User ID who reviewed\"/>\n        <column xsi:type=\"timestamp\" name=\"created_at\" on_update=\"false\" nullable=\"false\" default=\"CURRENT_TIMESTAMP\" comment=\"Created At\"/>\n        <column xsi:type=\"timestamp\" name=\"updated_at\" on_update=\"true\" nullable=\"false\" default=\"CURRENT_TIMESTAMP\" comment=\"Updated At\"/>\n        \n        <constraint xsi:type=\"primary\" referenceId=\"PRIMARY\">\n            <column name=\"suggestion_id\"/>\n        </constraint>\n        \n        <constraint xsi:type=\"foreign\" referenceId=\"VENDOR_IMAGE_TAG_SUGGESTION_PRODUCT_ID\"\n                    table=\"vendor_image_tag_suggestion\" column=\"product_id\"\n                    referenceTable=\"catalog_product_entity\" referenceColumn=\"entity_id\"\n                    onDelete=\"CASCADE\"/>\n        \n        <constraint xsi:type=\"foreign\" referenceId=\"VENDOR_IMAGE_TAG_SUGGESTION_ADMIN_USER_ID\"\n                    table=\"vendor_image_tag_suggestion\" column=\"admin_user_id\"\n                    referenceTable=\"admin_user\" referenceColumn=\"user_id\"\n                    onDelete=\"SET NULL\"/>\n        \n        <index referenceId=\"VENDOR_IMAGE_TAG_SUGGESTION_PRODUCT_ID\" indexType=\"btree\">\n            <column name=\"product_id\"/>\n        </index>\n        \n        <index referenceId=\"VENDOR_IMAGE_TAG_SUGGESTION_STATUS\" indexType=\"btree\">\n            <column name=\"status\"/>\n        </index>\n    </table>\n    \n    <table name=\"vendor_image_analysis_log\" resource=\"default\" engine=\"innodb\" comment=\"Image Analysis Log\">\n        <column xsi:type=\"int\" name=\"log_id\" unsigned=\"true\" nullable=\"false\" identity=\"true\" comment=\"Log ID\"/>\n        <column xsi:type=\"int\" name=\"product_id\" unsigned=\"true\" nullable=\"false\" comment=\"Product ID\"/>\n        <column xsi:type=\"varchar\" name=\"image_path\" nullable=\"false\" length=\"255\" comment=\"Image Path\"/>\n        <column xsi:type=\"text\" name=\"raw_response\" nullable=\"true\" comment=\"Raw AI Service Response\"/>\n        <column xsi:type=\"varchar\" name=\"status\" nullable=\"false\" length=\"50\" comment=\"Status: success, error\"/>\n        <column xsi:type=\"text\" name=\"error_message\" nullable=\"true\" comment=\"Error Message\"/>\n        <column xsi:type=\"timestamp\" name=\"analyzed_at\" on_update=\"false\" nullable=\"false\" default=\"CURRENT_TIMESTAMP\" comment=\"Analyzed At\"/>\n        \n        <constraint xsi:type=\"primary\" referenceId=\"PRIMARY\">\n            <column name=\"log_id\"/>\n        </constraint>\n        \n        <constraint xsi:type=\"foreign\" referenceId=\"VENDOR_IMAGE_ANALYSIS_LOG_PRODUCT_ID\"\n                    table=\"vendor_image_analysis_log\" column=\"product_id\"\n                    referenceTable=\"catalog_product_entity\" referenceColumn=\"entity_id\"\n                    onDelete=\"CASCADE\"/>\n        \n        <index referenceId=\"VENDOR_IMAGE_ANALYSIS_LOG_PRODUCT_ID\" indexType=\"btree\">\n            <column name=\"product_id\"/>\n        </index>\n    </table>\n    \n</schema>",
    "etc/communication.xml": "<?xml version=\"1.0\"?>\n<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:framework:Communication/etc/communication.xsd\">\n    <topic name=\"vendor.image.tagging.bulk.analyze\" request=\"Vendor\\ImageTagging\\Api\\Data\\BulkAnalysisRequestInterface\">\n        <handler name=\"bulkAnalysisHandler\" type=\"Vendor\\ImageTagging\\Model\\BulkAnalysis\\Consumer\" method=\"process\"/>\n    </topic>\n</config>",
    "etc/queue_topology.xml": "<?xml version=\"1.0\"?>\n<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n        xsi:noNamespaceSchemaLocation=\"urn:magento:framework-message-queue:etc/topology.xsd\">\n    <exchange name=\"magento\" type=\"topic\" connection=\"amqp\">\n        <binding id=\"vendorImageTaggingBulkAnalyze\" topic=\"vendor.image.tagging.bulk.